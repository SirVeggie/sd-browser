PORT=4200
PASS=1234
# required behind a reverse proxy (e.g. Caddy) so rate limits use the real client IP
ADDRESS_HEADER=X-Forwarded-For
IMG_FOLDER=C:\sd-webui\outputs
# Multiple separate source folders (semicolon-separated). When set, overrides IMG_FOLDER.
# With 2+ roots, folder paths are namespaced by root basename (e.g. outputs/txt2img).
#IMG_FOLDERS=C:\sd-webui\outputs;D:\comfy\output
# optional, ComfyUI URL used by "Open in ComfyUI" (defaults to http://127.0.0.1:8188)
#COMFY_URL=http://127.0.0.1:8188
# optional, ComfyUI-Login API token from the Comfy console
#COMFY_TOKEN=
# optional, defaults to ./localData (npm run dev uses ./devLocalData and ./devImages)
#LOCAL_DATA=./localData
# optional, positive values will enable polling, 0 will disable it
#POLLING_SECONDS=5