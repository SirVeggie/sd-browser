{
	"name": "sd-browser",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "cross-env BODY_SIZE_LIMIT=10485760 node -r dotenv/config build",
		"start:pm2": "pm2 startOrReload ecosystem.config.cjs",
		"stop:pm2": "pm2 delete ecosystem.config.cjs",
		"dev": "cross-env LOCAL_DATA=./devLocalData IMG_FOLDER=./devImages BODY_SIZE_LIMIT=10485760 vite dev",
		"ddev": "npm run dev -- --host",
		"setup": "npm i && npm run build",
		"prod": "npm i && npm run build && npm start",
		"deploy": "npm run fetch && npm run prod",
		"fetch": "git fetch --all && git reset --hard origin/master",
		"build": "vite build && npm run build:worker",
		"build:worker": "node scripts/build-extradata-worker.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:models": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/model-parser.test.ts",
		"test:exploration": "node --experimental-strip-types tests/exploration.unique.test.ts",
		"test:searching": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/searching.test.ts",
		"test:search-regex": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/searchRegex.test.ts",
		"test:searchReferences": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/searchReferences.test.ts",
		"test:search-references": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/searchReferences.test.ts",
		"test:similarity-sort": "node --experimental-strip-types tests/similaritySort.test.ts",
		"test:mmr": "node --experimental-strip-types tests/mmr.test.ts",
		"test:prune": "node --experimental-strip-types tests/prune.test.ts",
		"test:convert": "node --experimental-strip-types tests/convert.test.ts",
		"test:folder-menu": "node --experimental-strip-types tests/folderMenu.test.ts",
		"test:file-settle": "node --experimental-strip-types tests/fileSettle.test.ts",
		"test:params-inherit": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/paramsInherit.test.ts",
		"test:png-text": "node --experimental-strip-types tests/pngTextChunks.test.ts",
		"test:byte-range": "node --experimental-strip-types tests/byteRange.test.ts",
		"test:video-slideshow": "node --experimental-strip-types tests/videoSlideshow.test.ts",
		"test:flyout-width": "node --experimental-strip-types tests/flyoutWidth.test.ts",
		"test:format-error": "node --experimental-strip-types tests/formatError.test.ts",
		"test:keyed-element-map": "node --experimental-strip-types tests/keyedElementMap.test.ts",
		"test:error-dismiss": "node --experimental-strip-types tests/errorDismiss.test.ts",
		"test:int-control": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/intControl.test.ts",
		"test:layout-inherit": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/layoutInherit.test.ts",
		"test:autocomplete": "node --experimental-strip-types --import ./scripts/register-ts-extension.mjs tests/autocomplete.test.ts",
		"test:dropdown-outside-click": "node --experimental-strip-types tests/dropdownOutsideClick.test.ts"
	},
	"dependencies": {
		"@napi-rs/webcodecs": "^1.3.1",
		"better-sqlite3": "^11.0.0",
		"dotenv": "^16.3.1",
		"exifr": "^7.1.3",
		"lodash": "^4.17.21",
		"re2": "^1.24.1",
		"sharp": "^0.35.1",
		"sqlite-vec": "^0.1.9",
		"svelte-loading-spinners": "^0.3.4",
		"uuid": "^9.0.1",
		"watcher": "^2.2.2",
		"ws": "^8.21.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^2.0.0",
		"@sveltejs/adapter-node": "^1.3.0",
		"@sveltejs/kit": "^1.20.4",
		"@types/better-sqlite3": "^7.6.10",
		"@types/lodash": "^4.14.195",
		"@types/node": "^20.3.2",
		"@types/uuid": "^9.0.8",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.45.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.25.0",
		"eslint": "^8.28.0",
		"eslint-plugin-svelte": "^2.30.0",
		"sass": "^1.80.4",
		"svelte": "^4.0.0",
		"svelte-check": "^3.4.3",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^4.3.6"
	}
}
